# Point these to your local media directories.
# Copy this file to .env and adjust paths.

# Directory containing your video clip files
CLIPS_DIR=/Users/thomassmajstrla/Documents/pictures/korea/use/2024

# Directory containing your music files
MUSIC_DIR=/Users/thomassmajstrla/Music

# Directory where project save files (.json) are stored
PROJECTS_DIR=/Users/thomassmajstrla/Movies/music-videos

# Directory where backend log files are written (default: ./logs in this repo)
# LOGS_DIR=./logs

# Log verbosity: debug | info | warn | error (default: info)
# debug adds per-segment render timings, ffmpeg command lines, and media requests
# LOG_LEVEL=info

# Days of daily log files to keep before they are deleted (default: 14)
# LOG_RETENTION_DAYS=14
